# ============================================================================
# Local Testing Configuration for Entra ID Authentication
# ============================================================================
# Copy this file to 'default-env.json' or create a '.env' file
# 
# For local testing, you have two options:
# 1. Use ngrok for HTTPS (recommended): ngrok http 3000
# 2. Use localhost with HTTP (requires Entra ID configuration)
# ============================================================================

# Authentication Mode
AUTH_MODE=entra

# ============================================================================
# Microsoft Entra ID Configuration
# ============================================================================
# Get these from Azure Portal > App registrations > Your App

ENTRA_TENANT_ID=your-tenant-id-from-azure-portal
ENTRA_CLIENT_ID=your-client-id-from-azure-portal
ENTRA_CLIENT_SECRET=your-client-secret-from-azure-portal

# For ngrok (recommended):
# ENTRA_REDIRECT_URI=https://your-ngrok-url.ngrok.io/oauth/entra/callback

# For localhost (development only):
ENTRA_REDIRECT_URI=http://localhost:3000/oauth/entra/callback

# ============================================================================
# SAP System Configuration
# ============================================================================
# Your SAP system must be accessible from your local machine
SAP_BASE_URL=https://a4h.computerservice-wolf.com:50001

# ============================================================================
# Entra ID Custom Attribute Names
# ============================================================================
# These match the extension attributes you created in Azure Portal
ENTRA_SAP_USERNAME_CLAIM=extensionSAPUsername
ENTRA_SAP_PASSWORD_CLAIM=extensionSAPPassword

# ============================================================================
# Session Configuration
# ============================================================================
# Generate a random secret for local testing
SESSION_SECRET=local-test-secret-change-for-production
SESSION_TIMEOUT_MS=3600000

# ============================================================================
# Server Configuration
# ============================================================================
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ============================================================================
# Quick Start Instructions
# ============================================================================
# 
# 1. Install dependencies:
#    npm install
# 
# 2. Build the project:
#    npm run build
# 
# 3. Option A - Using ngrok (recommended):
#    - Start ngrok: ngrok http 3000
#    - Copy the ngrok URL (e.g., https://abc123.ngrok.io)
#    - Update ENTRA_REDIRECT_URI above with: https://abc123.ngrok.io/oauth/entra/callback
#    - Update Azure Portal redirect URI to match
#    - Start server: npm start
#    - Open browser: https://abc123.ngrok.io/oauth/entra/authorize
# 
# 4. Option B - Using localhost:
#    - Update Azure Portal redirect URI to: http://localhost:3000/oauth/entra/callback
#    - Start server: npm start
#    - Open browser: http://localhost:3000/oauth/entra/authorize
# 
# 5. Test endpoints:
#    - Health: http://localhost:3000/health
#    - User info: http://localhost:3000/oauth/entra/userinfo (after login)
#    - Stats: http://localhost:3000/oauth/entra/stats
# 
# ============================================================================

