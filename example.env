# ========================================
# BTP SAP OData to MCP Server Configuration
# ========================================
# Copy this file to .env and configure with your values

# ========================================
# Server Configuration
# ========================================

# HTTP server port (default: 3144)
PORT=3144

# Node environment (development|production)
NODE_ENV=production

# Logging level (error|warn|info|debug)
LOG_LEVEL=info

# ========================================
# Bearer Token Authentication
# ========================================
# IMPORTANT: Set this to enable bearer token auth for /mcp endpoint
# Generate a secure token: openssl rand -hex 32
# If not set, server runs WITHOUT bearer token authentication

ACCESS_TOKEN=your-secret-token-here

# ========================================
# SAP Destination Configuration
# ========================================

# Name of the SAP destination to use (default: SAP_SYSTEM)
SAP_DESTINATION_NAME=SAP_SYSTEM

# For local development without BTP Destination service:
# Provide destinations as JSON array
# destinations=[{"name":"SAP_SYSTEM","url":"https://<host>:<port>","username":"<user>","password":"<pass>"}]

# If using self-signed certificates (local only, NOT for production):
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ========================================
# Service Discovery Configuration
# ========================================

# Control which services are discovered and exposed
# See docs/SERVICE_DISCOVERY_CONFIG.md for details

# Include services matching these patterns (comma-separated)
# SERVICE_INCLUDE_PATTERNS=*Sales*,*Customer*,*Product*

# Exclude services matching these patterns (comma-separated)
# SERVICE_EXCLUDE_PATTERNS=*Test*,*Mock*,*Temp*

# Service categories to include (comma-separated)
# Available categories: sales, purchasing, finance, hr, logistics, master-data, analytics, custom
# SERVICE_CATEGORIES=sales,purchasing,master-data

# Maximum number of services to discover (default: no limit)
# MAX_SERVICES=50

# ========================================
# MCP Tool Registry Configuration
# ========================================

# Tool registry type (hierarchical|flat)
# hierarchical: Search/discovery tools + dynamic CRUD
# flat: Direct CRUD tools for all entities (more tools, faster execution)
MCP_TOOL_REGISTRY_TYPE=hierarchical

# Disable ReadEntity tool registration for all services (true|false)
# This reduces the number of registered tools significantly
DISABLE_READ_ENTITY_TOOL=false

# ========================================
# OAuth/XSUAA Configuration (Optional)
# ========================================
# If using BTP with XSUAA service binding, these are auto-loaded from VCAP_SERVICES
# Manual configuration not typically needed when deployed to BTP

# XSUAA_CLIENT_ID=your-client-id
# XSUAA_CLIENT_SECRET=your-client-secret
# XSUAA_URL=https://your-tenant.authentication.region.hana.ondemand.com
# XSUAA_IDENTITY_ZONE=your-identity-zone

# ========================================
# Advanced Configuration
# ========================================

# Enable debug mode for direct run detection
# DEBUG_START=true

# Auto-start when module is imported (used by PM2)
# AUTO_START=true

